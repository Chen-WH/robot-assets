<mujoco model="reorientation_cube">
  <asset>
    <texture name="cube" type="cube"
             fileup="../textures/fileup.png"
             fileback="../textures/fileback.png"
             filedown="../textures/filedown.png"
             filefront="../textures/filefront.png"
             fileleft="../textures/fileleft.png"
             fileright="../textures/fileright.png"/>
    <material name="cube" texture="cube"/>
    <texture name="graycube" type="cube"
            fileup="../textures/grayup.png"
             fileback="../textures/grayback.png"
             filedown="../textures/graydown.png"
             filefront="../textures/grayfront.png"
             fileleft="../textures/grayleft.png"
             fileright="../textures/grayright.png"/>
    <material name="graycube" texture="graycube"/>
    <!-- simple colored materials for axis visualization -->
    <material name="red" rgba="1 0 0 1"/>
    <material name="green" rgba="0 1 0 1"/>
    <material name="blue" rgba="0 0 1 1"/>
  </asset>
  <option timestep="0.0025" gravity="0 0 0"/>

  <worldbody>
    <light pos="0 0 1"/>
    <body name="cube" pos="0.0 0.0 0.5" quat="0 1 0 0">
      <freejoint/>
      <!-- main cube -->
      <!-- Contact parameters for hand-cube pairs are declared on the HAND side and
           taken from there outright: the hand geoms carry priority="1" and this one
           priority="0", and MuJoCo resolves a pair with unequal priorities by using
           the higher one's friction, condim, solref and solimp.  So nothing below
           reaches a fingertip contact.

           ~~Every axis must sit below anything the hand will ever use.~~ SUPERSEDED
           2026-09-10 by the priority declaration.  That rule existed because without
           priority the pair's friction is the elementwise MAX of the two geoms, which
           put a floor under any hand-side value and made randomising below it a no-op
           -- and it was per axis, which is how the cube's torsional 0.005 came to sit
           above the hand's 0.003 and would have governed torsion the moment condim
           went to 4.  The values are kept where the old rule left them rather than
           raised to something physical, because they still govern cube-vs-world
           contacts (floor, and any other priority-0 geom) and raising them would be
           an unmeasured change to a behaviour nothing currently asks about. -->
      <geom name="cube" type="box" size=".03 .03 .03" mass=".122" material="cube"
            priority="0" friction="0.05 0.0001 0.0001"/>

      <!-- visualization axes (rotate with cube) -->
      <!-- X axis: red -->
      <geom name="axis_x" type="box" size=".03 .002 .002" pos=".03 0 0" material="red" contype="0" conaffinity="0" density="0"/>
      <!-- Y axis: green -->
      <geom name="axis_y" type="box" size=".003 .03 .002" pos="0 .03 0" material="green" contype="0" conaffinity="0" density="0"/>
      <!-- Z axis: blue -->
      <geom name="axis_z" type="box" size=".003 .002 .03" pos="0 0 .03" material="blue" contype="0" conaffinity="0" density="0"/>
    </body>
  </worldbody>

  <sensor>
      <framepos name="cube_position" objtype="body" objname="cube"/>
      <framequat name="cube_orientation" objtype="body" objname="cube"/>
      <framelinvel name="cube_linear_velocity" objtype="body" objname="cube"/>
      <frameangvel name="cube_angular_velocity" objtype="body" objname="cube"/>
  </sensor>
</mujoco>
